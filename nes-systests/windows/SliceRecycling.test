# name: windows/SliceRecycling.test
# description: Slice recycling is a correctness no-op: garbage-collected slices are reset and reused for
#              later time ranges instead of being destroyed, and results must match the recycling-off
#              baselines these queries were copied from. The aggregation is Manufacturing (benchmark_small)
#              with a 60:1 sliding overlap, so slices retire continuously while the query runs; the join is
#              copied verbatim from join/JoinMultipleKeys.test.
# groups: [WindowOperators, Aggregation, Join]

GlobalConfiguration worker.default_query_execution.slice_cache.enable_slice_recycling: [true]

# Source definitions
CREATE LOGICAL SOURCE manufacturing(creationTS UINT64, messageIndex UINT64, mf01 INT16, mf02 INT16, mf03 INT16, pc13 INT16, pc14 INT16, pc15 INT16, pc25 INT16, pc26 INT16, pc27 INT16, res INT16, bm05 INT16, bm06 INT16);
CREATE PHYSICAL SOURCE FOR manufacturing TYPE File;
ATTACH FILE small/manufacturing/manufacturing_100K.csv

CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH FILE small/stream.csv

CREATE LOGICAL SOURCE stream2(id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream2 TYPE File;
ATTACH FILE small/stream2.csv

CREATE SINK manufacturingChecksum(start UINT64 NOT NULL, end UINT64 NOT NULL, avg_mf01 FLOAT64, sum_mf02 INT64, min_mf03 INT16, count_mf01 UINT64 NOT NULL, sum_mf01 INT64)  TYPE Checksum ;
CREATE SINK sinkStreamStream2(start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL) TYPE File;

# Query 1 - sliding-window aggregation copied from benchmark_small/Manufacturing.test
SELECT start, end, AVG(mf01) AS avg_mf01, SUM(mf02) AS sum_mf02, MIN(mf03) AS min_mf03, COUNT(mf01) AS count_mf01, SUM(mf01) AS sum_mf01
FROM manufacturing
WINDOW SLIDING(creationTS, SIZE 1 MINUTE, ADVANCE BY 1 SEC)
INTO manufacturingChecksum;
----
77 264968

# Query 2 - windowed join copied from join/JoinMultipleKeys.test, exercising the join slice state:
# NLJ paged vectors or HJ hash maps, depending on the join strategy the runner was given.
SELECT start, end, id, value, timestamp1, id2, value2, timestamp2
FROM (
  SELECT * FROM (SELECT * FROM stream) INNER JOIN (SELECT * FROM stream2) ON (id = id2 AND value = value2) WINDOW TUMBLING (timestamp1, timestamp2, size 1 sec)
)
INTO sinkStreamStream2;
