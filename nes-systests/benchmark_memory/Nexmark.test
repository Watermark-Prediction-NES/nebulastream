# name: benchmark_memory/Nexmark.test
# description: Nexmark benchmark taken from https://github.com/nexmark/nexmark/tree/master/nexmark-flink/src/main/resources/queries (in-memory source replay, output discarded)
# groups: [benchmark_memory, large]

# Source definitions
CREATE LOGICAL SOURCE bid(timestamp UINT64 NOT NULL, auctionId INT32 NOT NULL, bidder INT32 NOT NULL, datetime INT64 NOT NULL, price FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR bid TYPE Memory;
ATTACH FILE large/nexmark/bid_653M.csv
CREATE LOGICAL SOURCE auction(timestamp UINT64 NOT NULL, id INT32 NOT NULL, initialbid INT32 NOT NULL, reserve INT32 NOT NULL, expires INT64 NOT NULL, seller INT32 NOT NULL, category INT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR auction TYPE Memory;
ATTACH FILE large/nexmark/auction_modified_74M.csv

CREATE SINK q1Sink(price FLOAT64 NOT NULL)  TYPE Void;
CREATE SINK q2Sink(timestamp UINT64 NOT NULL, auctionId INT32 NOT NULL, bidder INT32 NOT NULL, datetime INT64 NOT NULL, price FLOAT64 NOT NULL)  TYPE Void;
CREATE SINK q5Sink(start UINT64 NOT NULL, end UINT64 NOT NULL, auctionId INT32 NOT NULL, num UINT64 NOT NULL, max_tmp UINT64 NOT NULL)  TYPE Void;
CREATE SINK q8VariantSink(start UINT64 NOT NULL, end UINT64 NOT NULL, bid_timestamp UINT64 NOT NULL, auctionId INT32 NOT NULL, bidder INT32 NOT NULL, datetime INT64 NOT NULL, price FLOAT64 NOT NULL, auction_timestamp UINT64 NOT NULL, id INT32 NOT NULL, initialbid INT32 NOT NULL, reserve INT32 NOT NULL, expires INT64 NOT NULL, seller INT32 NOT NULL, category INT32 NOT NULL)  TYPE Void;

# Query 0
SELECT * FROM bid INTO q2Sink;
----

# Query 1
SELECT price * 89 / 100 AS price FROM bid INTO q1Sink;
----

# Query 2
SELECT * FROM bid WHERE auctionId % 123 = 0 INTO q2Sink;
----

# Query 5
SELECT start, end, auctionId, num, max_tmp
FROM (SELECT auctionId, num, start as auction_start, end as auction_end
      FROM (SELECT auctionId, COUNT(auctionId) AS num, start, end
            FROM bid
            GROUP BY auctionId
            WINDOW SLIDING(timestamp, SIZE 10 SEC, ADVANCE BY 2 SEC)))
INNER JOIN (SELECT max_tmp, start as bid_start, end as bid_end
              FROM (SELECT MAX(num_ids) AS max_tmp, start, end
                    FROM
                          (SELECT auctionId, COUNT(auctionId) AS num_ids, start
                           FROM bid
                           GROUP BY auctionId
                           WINDOW SLIDING(timestamp, SIZE 10 SEC, ADVANCE BY 2 SEC))
                    WINDOW TUMBLING(start, SIZE 2 SEC)))
ON num == max_tmp
WINDOW TUMBLING(auction_start, bid_start, SIZE 2 SEC)
INTO q5Sink;
----


# Query 8 Variant (We are not using the actual Q8 but a variant, as we have swapped the Person stream with the Bid stream)
SELECT start, end, bid_timestamp, auctionId, bidder, datetime, price, auction_timestamp, id, initialbid, reserve, expires, seller, category
    FROM (SELECT timestamp as bid_timestamp, auctionId, bidder, datetime, price FROM bid)
INNER JOIN
    (SELECT timestamp as auction_timestamp, id, initialbid, reserve, expires, seller, category FROM auction)
ON auctionId = id WINDOW TUMBLING (bid_timestamp, auction_timestamp, size 10 sec) INTO q8VariantSink;
----
