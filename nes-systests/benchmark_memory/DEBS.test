# name: benchmark_memory/DEBS.test
# description: Queries from our DEBS tutorial (in-memory source replay, output discarded)
# groups: [benchmark_memory, large]

# Source definitions
CREATE LOGICAL SOURCE solarPanels(producerId INT32 NOT NULL, groupId INT32 NOT NULL, producedPower FLOAT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR solarPanels TYPE Memory;
ATTACH FILE large/debs/SOLAR_PANELS_TOPIC_1G.csv

CREATE LOGICAL SOURCE windTurbines(producerId INT32 NOT NULL, groupId INT32 NOT NULL, producedPower FLOAT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR windTurbines TYPE Memory;
ATTACH FILE large/debs/WIND_TURBINES_TOPIC_5M.csv

CREATE LOGICAL SOURCE consumers(consumerId INT32 NOT NULL, sectorId INT32 NOT NULL, consumedPower FLOAT64 NOT NULL, consumerType VARSIZED NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR consumers TYPE Memory;
ATTACH FILE large/debs/CONSUMERS_TOPIC_1G.csv

CREATE SINK consumersSink(consumerId INT32 NOT NULL, sectorId INT32 NOT NULL, consumedPower FLOAT64 NOT NULL, consumerType VARSIZED NOT NULL, timestamp UINT64 NOT NULL)  TYPE Void;
CREATE SINK solarPanelsSink(producerId INT32 NOT NULL, groupId INT32 NOT NULL, producedPower FLOAT64 NOT NULL, timestamp UINT64 NOT NULL)  TYPE Void;
CREATE SINK q4Sink(consumedPower FLOAT64 NOT NULL)  TYPE Void;
CREATE SINK q5Sink(producerId INT32 NOT NULL, groupId INT32 NOT NULL, producedPower FLOAT64 NOT NULL, ts UINT64 NOT NULL)  TYPE Void;
CREATE SINK q6Sink(source UINT64 NOT NULL, producerId INT32 NOT NULL, groupId INT32 NOT NULL, producedPower FLOAT64 NOT NULL, ts UINT64 NOT NULL)  TYPE Void;
CREATE SINK winPowerProductionSink(start UINT64 NOT NULL, end UINT64 NOT NULL, groupId INT32 NOT NULL, producedPower FLOAT64 NOT NULL)  TYPE Void;

# Query 0a - Simple Source Sink with consumers stream
SELECT * FROM consumers INTO consumersSink;
----

# Query 0b - Simple Source Sink with solarPanels stream
SELECT * FROM solarPanels INTO solarPanelsSink;
----

# Query 1 - Filter tuples
SELECT * FROM consumers WHERE consumedPower >= 400 INTO consumersSink;
----

# Query 2 - Filter with multiple attributes
SELECT * FROM consumers WHERE consumedPower >= 400 AND sectorId = 1 INTO consumersSink;
----

# Query 3 - Filter with complex expression
SELECT * FROM consumers WHERE consumedPower >= 1 AND consumedPower < 61 INTO consumersSink;
----

# Query 4 - Filter with complex expression
SELECT consumedPower / 1000 AS consumedPower FROM consumers INTO q4Sink;
----

# Query 5 - Union Queries
# Results are verified using: https://gist.github.com/ls-1801/d03e4cfbe2957efdace1efe075c5fb95
SELECT
    producerId,
    groupId,
    producedPower,
    timestamp as ts
FROM windTurbines
UNION
SELECT
    producerId,
    groupId,
    producedPower,
    timestamp as ts
FROM solarPanels
INTO q5Sink;
----

# Query 6 - More union with additional projection to distinguish between union streams
# Results are verified using: https://gist.github.com/ls-1801/d03e4cfbe2957efdace1efe075c5fb95
SELECT
    source,
    producerId,
    groupId,
    producedPower,
    timestamp as ts
FROM (
    SELECT *, UINT64(1) AS source
    FROM windTurbines
        UNION
    SELECT *, UINT64(2) AS source
    FROM solarPanels
)
INTO q6Sink;
----

# Query 7 - Window aggregations with tumbling windows
SELECT start, end, groupId, SUM(producedPower) AS producedPower
FROM solarPanels
GROUP BY groupId
WINDOW TUMBLING(timestamp, SIZE 1 HOUR)
INTO winPowerProductionSink;
----

# Query 8 - Window aggregations with sliding windows
SELECT start, end, groupId, SUM(producedPower) AS producedPower
FROM solarPanels
GROUP BY groupId
WINDOW SLIDING(timestamp, SIZE 1 HOUR, ADVANCE BY 10 MINUTES)
INTO winPowerProductionSink;
----
