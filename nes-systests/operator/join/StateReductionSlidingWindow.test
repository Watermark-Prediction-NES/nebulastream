# name: join/StateReductionSlidingWindow.test
# description: The case state reduction exists for: with a sliding window a slice outlives the first
#              window that contains it, so between its end and its last window it sits idle in memory and
#              is eligible for reduction. It has to come back intact for every one of those windows, not
#              just the first. Query and expected output copied verbatim from
#              join/SlidingWindowFullOuterJoin.test.
# groups: [StateReduction]

# forced_decision values are the C++ enumerator names, which is what magic_enum parses.
# FORCED + KeepInMemory is the in-memory baseline, so the first variant of this file is the reference the
# other three are checked against.
GlobalConfiguration worker.default_query_execution.state_reduction.enabled: [true]
GlobalConfiguration worker.default_query_execution.state_reduction.predictor: [FORCED]
GlobalConfiguration worker.default_query_execution.state_reduction.forced_decision: [KeepInMemory, CompressInMemory, Spill, CompressAndSpill]

# Source definitions
# Left stream: id=1 in slice 1 (t=500), id=2 in slice 1 (t=1500), id=3 in slice 2 (t=2500)
# Right stream: id2=1 in slice 2 (t=2500) — cross-slice match with left id=1; id2=4 has no left match
# Window W1=[0,4000): matched (id=1,id2=1), unmatched left (id=2, id=3), unmatched right (id2=4)
# Window W2=[2000,6000): unmatched left (id=3), unmatched right (id2=1, id2=4)
# Without Plan 01 fix: pass-2 fires N-squared times producing 4 copies of unmatched-right row for id2=4
CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
1,10,500
2,20,1500
3,30,2500

CREATE LOGICAL SOURCE stream2(id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream2 TYPE File;
ATTACH INLINE
1,100,2500
4,400,3500

CREATE SINK sink(start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64, value UINT64, timestamp UINT64, id2 UINT64, value2 UINT64, timestamp2 UINT64) TYPE File;

SELECT *
FROM (SELECT * FROM stream) FULL OUTER JOIN (SELECT * FROM stream2)
ON (id = id2)
WINDOW SLIDING (timestamp, timestamp2, size 4 sec, advance by 2 sec)
INTO sink;
----
0,4000,1,10,500,1,100,2500
0,4000,2,20,1500,NULL,NULL,NULL
0,4000,3,30,2500,NULL,NULL,NULL
0,4000,NULL,NULL,NULL,4,400,3500
2000,6000,3,30,2500,NULL,NULL,NULL
2000,6000,NULL,NULL,NULL,1,100,2500
2000,6000,NULL,NULL,NULL,4,400,3500

